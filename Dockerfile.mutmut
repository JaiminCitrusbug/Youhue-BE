# Linux container for BE mutation testing (mutmut has no native Windows support — KIT_ADAPTATIONS A-4).
# Built once; the code is bind-mounted at run time. Talks to the host Postgres via host.docker.internal.
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt "mutmut<3"
