# Youhue backend — environment contract. Copy to .env for local dev (.env is gitignored).
# Every value is optional locally (sensible dev defaults in config/env_config.py); set the real ones per env.

# --- app ---
ENVIRONMENT=local                 # local | staging | production
API_PREFIX=/api/v1

# --- database (OWNER PROVIDES in the active env) ---
DATABASE_URL=postgresql+psycopg://youhue:youhue@localhost:5433/youhue_dev
DATABASE_URL_TEST=postgresql+psycopg://youhue:youhue@localhost:5433/youhue_test

# --- auth / session ---
JWT_SECRET=                       # leave blank locally (random per-process); REQUIRED in prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
STAFF_SESSION_TTL_MINUTES=720
STUDENT_SESSION_TTL_MINUTES=20
STUDENT_SINGLE_ACTIVE_DEVICE=true
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15

# --- external integrations: TEST/ACTIVE dual flow (ACTIVE_ENV governs every external provider) ---
ACTIVE_ENV=TEST                   # TEST (local/mock, no keys) | ACTIVE (real providers)
# email — TEST=local .eml sink (git-ignored) · ACTIVE=SendGrid
EMAIL_FILE_DIR=./var/mail
EMAIL_FROM=no-reply@youhue.app
SENDGRID_API_KEY=                 # required when ACTIVE_ENV=ACTIVE
SENDGRID_WEBHOOK_SECRET=          # required to accept delivery webhooks

# --- staff SSO (real OAuth; a provider turns on when its creds are present) ---
OAUTH_REDIRECT_BASE=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- MFA (email OTP only) ---
MFA_REQUIRED_ROLES=leadership,district,admin
MFA_OTP_TTL_MINUTES=10
MFA_OTP_LENGTH=6

# --- risk pipeline (D-05/D-18 pending ratification — env-driven) ---
RISK_IMMEDIATE_THRESHOLD=0.80
RISK_TRIAGE_THRESHOLD=0.50
SLOWBURN_LOW_MOOD_THRESHOLD=2
SLOWBURN_WINDOW_DAYS=5
DEFAULT_CONCERN_WORDS=hurt,scared,alone,hate,worthless,hopeless,unsafe,help

# --- rate limiting ---
RATE_LIMIT_SIGNIN_PER_MINUTE=10
